                    <html:br/>
                    <html:br/><html:label for="music-service-select">service:</html:label>
                    <html:select id="music-service-select" class="music-service-select" data-music-service="">
                        <html:option value="youtube">YouTube</html:option>
                        <html:option value="spotify">Spotify</html:option>
                        <html:option value="apple">Apple Music</html:option>
                    </html:select>
                </html:div>
            </html:details>
        </html:div>

        <html:div>
            <html:details id="updates" name="front-page-group">
                <html:summary>updates</html:summary>
                <html:div id="updates-div" class="details-div" style="font-size: 70%;height: 400px;overflow: scroll;max-width: 50rem;"/>
